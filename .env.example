# AI providers
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
LOCAL_OPENAI_API_KEY=
LOCAL_OPENAI_BASE_URL=http://host.docker.internal:11434/v1

# Provider selection
AI_CHAT_PROVIDER=openai
AI_EMBEDDING_PROVIDER=openai

# RAG defaults
RAG_COLLECTION=default
RAG_SESSION=default
RAG_EMBED_MODEL=text-embedding-3-small
RAG_CHAT_MODEL=gpt-4.1-mini
RAG_EMBED_DIMENSIONS=256
RAG_TOP_K=5
RAG_CONTEXT_BUDGET=6000

# LumenVec
LUMENVEC_IMAGE=brunomarques/lumenvec:latest
LUMENVEC_BASE_URL=http://localhost:19190
LUMENVEC_API_KEY=
LUMENVEC_BINARY=

# Local backend data path override
RAG_DATA_DIR=

# LumenRAG launcher workspace override
LUMENRAG_HOME=
